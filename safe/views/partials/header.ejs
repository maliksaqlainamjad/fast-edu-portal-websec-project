<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FAST Edu-Portal | <%= typeof mode !== 'undefined' ? mode : '' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">FAST Edu-Portal</a>
      <span class="badge bg-dark ms-2">SAFE VERSION — hardened</span>
      <div class="ms-auto">
        <% if (typeof user !== 'undefined' && user) { %>
          <a class="text-white me-3" href="/dashboard">Dashboard</a>
          <a class="text-white me-3" href="/account">Account</a>
          <a class="text-white" href="/logout">Logout (<%= user.username %>)</a>
        <% } else { %>
          <a class="text-white me-3" href="/login">Login</a>
          <a class="text-white" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </nav>
  <div class="container py-4">
