<%- include('partials/header') %>
<div id="welcome-banner" class="alert alert-secondary"></div>
<h3>Welcome, <%= user.full_name %></h3>
<p class="text-muted">Try visiting: <code class="payload">/dashboard#welcome=&lt;img src=x onerror=alert('DOM XSS')&gt;</code> — nothing fires here, the payload is shown as plain text.</p>
<h5 class="mt-4">Courses</h5>
<div class="row">
  <% courses.forEach(c => { %>
    <div class="col-md-6 mb-3">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title"><%= c.code %> — <%= c.title %></h5>
          <p class="card-text small"><%= c.description %></p>
          <a class="btn btn-sm btn-outline-success" href="/courses/<%= c.id %>">Open course page</a>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<form class="mt-3" action="/search" method="GET">
  <div class="input-group">
    <input class="form-control" name="q" placeholder="Search courses by title...">
    <button class="btn btn-success">Search</button>
  </div>
</form>
<script src="/js/dashboard.js"></script>
<%- include('partials/footer') %>
