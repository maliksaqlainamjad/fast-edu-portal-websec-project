<%- include('partials/header') %>
<h3>Account settings</h3>
<% if (updated) { %><div class="alert alert-success">Email updated.</div><% } %>
<p>Username: <strong><%= user.username %></strong></p>
<p>Current email on file: <strong id="current-email"><%= user.email || '(not loaded)' %></strong></p>

<!-- FIX #4: CSRF -> hidden, per-session token validated server-side -->
<form method="POST" action="/account/update-email">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="mb-3">
    <label class="form-label">Email</label>
    <input class="form-control" name="email" placeholder="new email">
  </div>
  <button class="btn btn-success">Update email</button>
</form>

<p class="text-muted small mt-3">
  Try submitting <code class="payload">vulnerable/attack-demo/malicious-csrf.html</code>
  while logged in here (point its form action at port 5000) — it gets rejected with
  <strong>403 Forbidden</strong> because it has no valid CSRF token.
</p>
<%- include('partials/footer') %>
